# CiteBolt frontend environment. Copy to `.env.local` and fill in if needed.

# Leave empty in development: the Vite dev server proxies /api to http://127.0.0.1:8001.
# In production, set it to your deployed backend URL (for example https://your-backend.example.com).
VITE_API_URL=

# Optional: shown on the Contact page.
VITE_SUPPORT_EMAIL=