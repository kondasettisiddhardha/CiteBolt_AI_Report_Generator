# Citebolt backend environment. Copy to `backend/.env` and fill in.

# --- LLM (Groq, required) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Web search (optional; falls back to DuckDuckGo) ---
TAVILY_API_KEY=

# --- Database ---
# SQLite by default (backend/data/reports.db). Set this to use Postgres:
# DATABASE_URL=postgresql://user:password@host:5432/citebolt
DATABASE_URL=

# --- Auth ---
# Session signing key. Generate one with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
SESSION_DAYS=7
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS=3
OTP_REQUEST_WINDOW_SECONDS=600

# --- Email (OTP delivery). Without either provider the code is printed to the console. ---
RESEND_API_KEY=
FROM_EMAIL=Citebolt <onboarding@resend.dev>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Contact form ---
CONTACT_EMAIL=
SUPPORT_EMAIL=

# --- Server ---
HOST=127.0.0.1
PORT=8000
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# --- Limits ---
DAILY_RUN_LIMIT=10
MAX_TOPIC_CHARS=300
MAX_CONTEXT_CHARS=40000
MAX_UPLOAD_BYTES=10485760

# --- Agent retries ---
RETRIES=2
BACKOFF=2
RUN_TTL_SECONDS=3600
